# Copie este archivo como .env y complete los valores (no suba .env al repositorio).

ENVIRONMENT=DEVELOPMENT
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

backend_host=db
backend_port=5432
backend_port_db_dev=5432
backend_user=postgres
backend_password=postgres
backend_database=backend

backend_port_api=8080
backend_port_adminer=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://${backend_host}:${backend_port}/${backend_database}
SPRING_DATASOURCE_USERNAME=${backend_user}
SPRING_DATASOURCE_PASSWORD=${backend_password}

SPRING_SECURITY_JWT_SECRET=cambie-este-secreto

# Asistente IA (OpenAI)
OPENAI_API_KEY=sk-su-clave-aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_ENABLED=true
